# RezeOS GSI base configuration
BASE_URL="https://sourceforge.net/projects/misterztr-gsi/files/LineageOS/Android%2016/LineageOS-23.2-20260524-VANILLA-EXT4-GSI.7z/download"
REZEOS_NAME="RezeOS"
REZEOS_VERSION="1.0-BETA"
REZEOS_CODENAME="Reze"

# The workflow sources this file before decoding the embedded wallpaper.
# Use GNU coreutils base64 with garbage-tolerant decoding so an incidental
# non-base64 character cannot abort the build before the filesystem is touched.
base64() {
  command /usr/bin/base64 --ignore-garbage "$@"
}
